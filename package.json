{
  "name": "ruoshui-comic",
  "version": "0.1.0",
  "description": "若水漫画 · 本地 AI 漫画创作工作室",
  "author": {
    "name": "kagemizu",
    "url": "https://github.com/Penumbrill"
  },
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "pack": "npm run build && electron-builder --win --dir",
    "preview": "node server/index.mjs",
    "release:portable": "node scripts/online-release.mjs",
    "release:installer": "node scripts/online-release.mjs"
  },
  "dependencies": {
    "lucide-vue-next": "^0.468.0",
    "pinia": "^2.3.0",
    "undici": "^6.29.0",
    "vue": "^3.5.13",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12",
    "vite": "^6.1.0"
  },
  "build": {
    "appId": "com.guangyingruoshui.comic",
    "productName": "若水漫画",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "assets/**/*",
      "scripts/bootstrap.ps1",
      "package.json",
      "shared/**/*",
      "!assets/**/__pycache__/**",
      "!assets/**/*.pyc",
      "!assets/**/*.db-wal",
      "!assets/**/*.db-shm"
    ],
    "win": {
      "target": "dir",
      "signAndEditExecutable": false,
      "icon": "assets/app-icon.ico"
    },
    "asar": true,
    "asarUnpack": [
      "assets/**/*",
      "scripts/bootstrap.ps1"
    ],
    "electronDist": "node_modules/electron/dist",
    "extraFiles": [
      {
        "from": "runtime",
        "to": "runtime",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/.git/**",
          "!cache/**",
          "!downloads/**",
          "!**/*.part",
          "!**/*.invalid-*",
          "!ComfyUI/custom_nodes/weilin-comfyui-tools/user_data/**",
          "!ComfyUI/custom_nodes/weilin-comfyui-tools/user_data_old/**",
          "!ComfyUI/custom_nodes/weilin-comfyui-tools/lora_userdatas/**",
          "!ComfyUI/custom_nodes/weilin-comfyui-tools/translate_userdatas/**",
          "!ComfyUI/custom_nodes/weilin-comfyui-tools/random_tag/**",
          "!ComfyUI/custom_nodes/weilin-comfyui-tools/init.json",
          "!ComfyUI/custom_nodes/weilin-comfyui-tools/user_cloud_package.json",
          "!ComfyUI/models/**",
          "!ComfyUI/user/**",
          "!ComfyUI/input/**",
          "!ComfyUI/output/**",
          "!ComfyUI/temp/**",
          "!ComfyUI/extra_model_paths.yaml",
          "!ComfyUI/extra_model_paths.yml",
          "!llama/**",
          "!**/*.safetensors",
          "!**/*.gguf",
          "!**/*.ckpt",
          "!ComfyUI/custom_nodes/weilin-comfyui-tools/tag_labels.json",
          "!receipt.json",
          "!**/*.onnx",
          "!**/*.pt",
          "!**/*.pth",
          "!**/*.log",
          "!**/*.bak",
          "!**/*.tmp",
          "!**/tests/**",
          "!**/tests-unit/**",
          "!**/.github/**"
        ]
      },
      {
        "from": "README.md",
        "to": "使用说明.md"
      },
      {
        "from": "README.en.md",
        "to": "README.en.md"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false,
      "include": "scripts/installer.nsh",
      "installerIcon": "assets/app-icon.ico",
      "uninstallerIcon": "assets/app-icon.ico",
      "artifactName": "ruoshui-comic.${ext}",
      "customNsisBinary": {
        "url": "https://github.com/SoundSafari/NSISBI-ElectronBuilder/releases/download/1.0.0/nsisbi-electronbuilder-3.10.3.7z",
        "checksum": "374cfc092fd1bd1898472df627549ecc165b0d6ba88e82deba085673aec95336"
      },
      "uninstallDisplayName": "若水漫画"
    }
  },
  "allowScripts": {
    "electron@35.7.5": true,
    "esbuild@0.25.12": true,
    "vue-demi@0.14.10": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Penumbrill/ruoshui-comic.git"
  },
  "homepage": "https://github.com/Penumbrill/ruoshui-comic"
}
